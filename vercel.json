{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": null,

  "builds": [
    {
      "src": "server/dist/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/public/**"
        ]
      }
    },
    {
      "src": "client/dist/**",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/dist/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "server/dist/index.js"
    },
    {
      "src": "/downloads/(.*)",
      "dest": "server/dist/index.js"
    },
    {
      "src": "/images/(.*)",
      "dest": "server/dist/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "client/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server/dist/index.js"
    }
  ],

  "env": {
    "NODE_ENV": "production"
  }
}
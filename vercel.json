{
  "version": 2,
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/downloads/(.*)", "destination": "/api/index" },
    { "source": "/images/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "alias": [
    "dipeshthapa23.com.np",
    "www.dipeshthapa23.com.np"
  ]
}
{
    "name":  "dipportfolio.github.io",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "3D academic research portfolio + CMS for Dipesh Thapa (React + Express + MongoDB)",
    "scripts":  {
                    "dev":  "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
                    "dev:server":  "tsx watch server/src/index.ts",
                    "dev:client":  "npm run dev --prefix client",
                    "build":  "npm run build --prefix client \u0026\u0026 npm run build:server",
                    "build:server":  "tsc --noEmit",
                    "start":  "tsx server/src/index.ts",
                    "lint":  "oxlint client/src server/src shared",
                    "typecheck":  "tsc --noEmit \u0026\u0026 npm run typecheck --prefix client",
                    "test":  "vitest run",
                    "seed":  "tsx server/src/scripts/seed-cv.ts",
                    "import:cv":  "tsx server/src/scripts/seed-cv.ts"
                },
    "keywords":  [
                     "portfolio",
                     "academic",
                     "research",
                     "cms",
                     "mongodb",
                     "threejs"
                 ],
    "author":  "Dipesh Thapa",
    "license":  "MIT",
    "workspaces":  [
                       "client",
                       "server"
                   ]
}

{
  "name": "dipportfolio.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D academic research portfolio + CMS for Dipesh Thapa (React + Express + MongoDB)",
  "author": "Dipesh Thapa",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "cd client && vite",
    "build": "npm run build:client",
    "build:client": "cd client && tsc -b && vite build",
    "build:server": "tsc --noEmit",
    "typecheck": "tsc --noEmit && cd client && tsc -b",
    "lint": "oxlint client/src server/src shared",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "seed": "tsx server/src/scripts/seed-cv.ts",
    "import:cv": "tsx server/src/scripts/seed-cv.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "multer": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "portfolio",
    "academic",
    "research",
    "cms",
    "mongodb",
    "threejs"
  ]
}